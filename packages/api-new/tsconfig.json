{
  "extends": "@fludge/config/tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "composite": true,
    "rootDir": ".",

    "paths": {
      "@*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src"]
}
