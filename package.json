{
  "name": "fludge",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/native",
      "apps/server",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "17.4.2",
      "zod": "4.4.3",
      "@types/bun": "1.4.0",
      "elysia": "1.4.29",
      "@orpc/server": "1.15.0",
      "@orpc/openapi": "1.15.0",
      "@orpc/zod": "1.15.0",
      "@orpc/tanstack-query": "1.15.0",
      "@orpc/client": "1.15.0",
      "better-auth": "1.7.1",
      "lucide-react": "1.33.0",
      "next-themes": "0.4.6",
      "sonner": "2.0.8",
      "@tanstack/react-table": "9.1.2",
      "@tanstack/react-query": "5.101.4",
      "@tanstack/react-form": "1.33.5",
      "tailwindcss": "4.3.3",
      "tailwind-merge": "3.6.0",
      "@better-auth/expo": "1.7.1",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "date-fns": "4.4.0",
      "decimal.js": "10.6.0",
      "uuid": "14.0.2",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "~19.3.0",
      "@types/react-dom": "19.2.4",
      "heroui-native": "1.0.8",
      "i18next": "26.4.1",
      "react-i18next": "17.0.13",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "dev:desktop": "turbo run dev -F desktop --",
    "db:remove": "rm local.db local.db-shm local.db-wal",
    "db:init": "turso dev -f local.db",
    "db:reset": "bun run db:remove && bun run db:init",
    "db:push": "turbo run db:push -F @fludge/db --",
    "db:studio": "turbo run db:studio -F @fludge/db --",
    "db:generate": "turbo run db:generate -F @fludge/db --",
    "db:migrate": "turbo run db:migrate -F @fludge/db --",
    "db:start": "turbo run db:start -F @fludge/db --",
    "db:watch": "turbo run db:watch -F @fludge/db --",
    "db:stop": "turbo run db:stop -F @fludge/db --",
    "db:down": "turbo run db:down -F @fludge/db --",
    "auth:generate": "turbo -F server auth:generate",
    "test": "turbo run test",
    "test:server": "turbo run test -F server --",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fludge/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "expo": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@fludge/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@expo/ui": "~58.0.20",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo-server": "58.0.5",
    "expo-build-properties": "~58.0.11"
  },
  "version": "1.0.0"
}
