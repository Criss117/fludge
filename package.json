{
  "name": "fludge",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.27",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@orpc/tanstack-query": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-form": "^1.33.2",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.27"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @fludge/db --",
    "db:studio": "turbo run db:studio -F @fludge/db --",
    "db:generate": "turbo run db:generate -F @fludge/db --",
    "db:migrate": "turbo run db:migrate -F @fludge/db --",
    "db:start": "turbo run db:start -F @fludge/db --",
    "db:watch": "turbo run db:watch -F @fludge/db --",
    "db:stop": "turbo run db:stop -F @fludge/db --",
    "db:down": "turbo run db:down -F @fludge/db --"
  },
  "dependencies": {
    "@fludge/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fludge/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
