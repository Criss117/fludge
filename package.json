{
  "name": "fludge",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "17.4.2",
      "zod": "4.4.3",
      "@types/bun": "1.4.0",
      "elysia": "1.4.29",
      "@orpc/server": "1.15.0",
      "@orpc/openapi": "1.15.0",
      "@orpc/zod": "1.15.0",
      "@orpc/tanstack-query": "1.15.0",
      "@orpc/client": "1.15.0",
      "better-auth": "1.7.1",
      "lucide-react": "1.33.0",
      "next-themes": "0.4.6",
      "sonner": "2.0.8",
      "@tanstack/react-table": "9.1.2",
      "@tanstack/react-query": "5.101.4",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-db": "0.3.1",
      "@tanstack/query-db-collection": "1.2.6",
      "tailwindcss": "4.3.3",
      "tailwind-merge": "3.6.0",
      "@better-auth/expo": "1.7.1",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "date-fns": "4.4.0",
      "decimal.js": "10.6.0",
      "uuid": "14.0.2",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "~19.2.17",
      "@types/react-dom": "19.2.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:remove": "rm local.db local.db-shm local.db-wal",
    "db:init": "turso dev -f local.db",
    "db:reset": "bun run db:remove && bun run db:init",
    "db:push": "turbo run db:push -F @fludge/db --",
    "db:studio": "turbo run db:studio -F @fludge/db --",
    "db:generate": "turbo run db:generate -F @fludge/db --",
    "db:migrate": "turbo run db:migrate -F @fludge/db --",
    "db:start": "turbo run db:start -F @fludge/db --",
    "db:watch": "turbo run db:watch -F @fludge/db --",
    "db:stop": "turbo run db:stop -F @fludge/db --",
    "db:down": "turbo run db:down -F @fludge/db --",
    "auth:generate": "turbo -F server auth:generate",
    "test": "turbo run test"
  },
  "dependencies": {
    "@fludge/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fludge/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@expo/ui": "~57.0.12",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2"
  }
}
