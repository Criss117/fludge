{
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsserver.maxMemory": 4096,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/.expo/**": true,
    "**/coverage/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/.expo": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true
  },
  "files.exclude": {
    "**/.turbo": true,
    "**/dist": true,
    "**/coverage": true
  }
}
